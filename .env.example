# Copy to .env locally. Do not commit real keys.
#
# Contest default: Gemini 3.5 Flash via Gemini API (AI Studio key). NOT Vertex.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_MODEL=gemini-3.5-flash

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# Firestore optional (local demo uses out/graph/*.json)
FIRESTORE_COLLECTION=evidence_graph
LEG_USE_FIRESTORE=false
LEG_OUT_DIR=out
LEG_HTTP_TIMEOUT=20

# Optional rate-limit helpers (public APIs work without keys)
OPENFDA_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=contest@example.com

LEG_USER_AGENT=living-evidence-graph/0.1 (contest scaffold; public data only; not a medical product)
